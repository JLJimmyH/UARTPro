#include <windows.h>
#include "version.h"

IDI_ICON1 ICON "lu_pixel.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
    PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS__WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "UARTPro"
            VALUE "FileDescription",  "UART PRO Serial Terminal"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "UARTPro"
            VALUE "OriginalFilename", "UARTPro.exe"
            VALUE "ProductName",      APP_NAME
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
